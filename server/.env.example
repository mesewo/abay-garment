# Server configuration
PORT=5000
NODE_ENV=development

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/abay-garment
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origins (comma-separate extra origins in CLIENT_URLS for previews)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173

# Google Sign-In (must match the client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Chapa payments
CHAPA_SECRET_KEY=
API_PUBLIC_URL=https://your-api-domain.onrender.com

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (OTP + password reset). In development the OTP is logged when unset.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
